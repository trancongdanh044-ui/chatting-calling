.call-modal
  .call-box
    .call-name
    .call-status
    .call-videos
      video(class="remote-video" autoplay playsinline)
      video(class="local-video" autoplay playsinline muted)
    .call-buttons
      button(class="btn-accept" type="button") <i class="fa-solid fa-phone"></i> Trả lời
      button(class="btn-end" type="button") <i class="fa-solid fa-phone-slash"></i> <span>Kết thúc</span>
