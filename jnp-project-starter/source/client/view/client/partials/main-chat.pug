if(myRoomChat)
  .chat(my-user-id=myUser.id my-user-name=myUser.fullName data-call-room-id=myRoomChat.id data-call-room-type=myRoomChat.typeRoom data-call-peer-id=(myRoomChat.friendId || "") data-call-name=myRoomChat.title data-call-avatar=myRoomChat.avatar)
    .inner-head
      div(class="box-user" my-friend-id=(myRoomChat.friendId || ""))
        a(class="user-avatar" href=`/profile/detail/${myRoomChat.friendId}`)
          img(src=myRoomChat.avatar, alt="")
          div(class="box-user-status" status-online=myRoomChat.statusOnlineFriend) 
        div(class="user-info")
          div(class="user-name") #{myRoomChat.title}
          div(class="user-status" user-status-box) 
            if(myRoomChat.statusOnlineFriend === "online")
              span Đang hoạt động
            else 
              span #{myRoomChat.friendLastOnline}
      div(class="box-tool")
        div(class="tool-item" call) <i class="fa-solid fa-phone"></i>
        div(class="tool-item" video-call) <i class="fa-solid fa-video"></i>
        div(class="tool-item" info) <i class="fa-solid fa-circle-info"></i>
    .inner-body
      each chat in chats 
        div(class=(chat.user_id == myUser.id ? "inner-outcoming" : "inner-incoming" ) data-message-time=(chat.createdAt ? new Date(chat.createdAt).toISOString() : ""))
          if(chat.user_id != myUser.id)
            .inner-avatar
              img(src=(chat.user_avatar || "/client/images/avatar.jpg"), alt="")
            .inner-message
              .inner-name
                | #{chat.fullName}
              if(chat.type == "call")
                - const info = chat.callInfo || {};
                - const isMissed = info.status === "missed" || info.status === "rejected";
                .inner-call-log(class=(isMissed ? "call-missed" : "call-completed"))
                  .call-icon
                    if(info.callType === "audio")
                      i.fa-solid.fa-phone
                    else
                      i.fa-solid.fa-video
                  .call-detail
                    .call-title
                      if(info.status === "missed")
                        | Cuộc gọi nhỡ
                      else if(info.status === "rejected")
                        | Cuộc gọi bị từ chối
                      else
                        | #{info.callType === "audio" ? "Cuộc gọi thoại" : "Cuộc gọi video"}
                    .call-subtitle
                      if(info.status === "completed")
                        - const mins = Math.floor((info.duration || 0) / 60);
                        - const secs = (info.duration || 0) % 60;
                        | #{mins > 0 ? `${mins} phút ` : ""}#{secs} giây
                      else
                        | Nhấn để gọi lại
                  button.btn-recall(type="button" data-call-type=(info.callType || "video"))
                    | Gọi lại
              else
                if(chat.content)
                  .inner-content 
                    | #{chat.content}
                if(chat.images && chat.images.length > 0)
                  .inner-images
                    each image in chat.images 
                      img(src=image, alt="Ảnh" width="250px" height="auto")
          else
            if(chat.type == "call")
              - const info = chat.callInfo || {};
              - const isMissed = info.status === "missed" || info.status === "rejected";
              .inner-call-log(class=(isMissed ? "call-missed" : "call-completed"))
                .call-icon
                  if(info.callType === "audio")
                    i.fa-solid.fa-phone
                  else
                    i.fa-solid.fa-video
                .call-detail
                  .call-title
                    if(info.status === "missed")
                      | Người nhận không trả lời
                    else if(info.status === "rejected")
                      | Cuộc gọi bị từ chối
                    else
                      | #{info.callType === "audio" ? "Cuộc gọi thoại" : "Cuộc gọi video"}
                  .call-subtitle
                    if(info.status === "completed")
                      - const mins = Math.floor((info.duration || 0) / 60);
                      - const secs = (info.duration || 0) % 60;
                      | #{mins > 0 ? `${mins} phút ` : ""}#{secs} giây
                    else
                      | Nhấn để gọi lại
                button.btn-recall(type="button" data-call-type=(info.callType || "video"))
                  | Gọi lại
            else
              if(chat.content)
                .inner-content 
                  | #{chat.content}
              if(chat.images && chat.images.length > 0)
                .inner-images
                  each image in chat.images 
                    img(src=image, alt="Ảnh" width="250px" height="auto")
      //- div(class="inner-list-typing")
      //-   div(class="box-typing")
      //-     div(class="inner-name") Lê Văn A
      //-     div(class="inner-dots")
      //-       span
      //-       span 
      //-       span
      <div class="tooltip" role="tooltip" data-popper-placement="right">
        <emoji-picker></emoji-picker>
      </div>
    .inner-preview-images 
      div(class="custom-file-container" data-upload-id="upload-image")
    .inner-foot
      form(
        class="inner-form"
        action=""
        method="POST"
      )
        input(
          type="text"
          placeholder="Nhập nội dung..."
          name="content"
        )
        label(
          for="file-upload-with-preview-upload-image" 
          class="btn btn-primary mb-0 m-2"
        ) 
          i(class="fa-solid fa-image")
        span(
          class="button-icon"
        )
          i(class="fa-solid fa-face-smile")
        button(
          type="submit"
        )
          i.fa-solid.fa-paper-plane
else
  .chat-empty
    p Chưa chọn cuộc trò truyện nào