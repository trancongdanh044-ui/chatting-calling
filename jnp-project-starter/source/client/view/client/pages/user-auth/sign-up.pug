extends ../../layouts/auth.pug
include ../../mixins/alert.pug

block right
  +alert-success(5000)
  +alert-error(5000)
  .col-6
    h1(class="mb-4 text-center") Đăng ký tài khoản
    .inner-login
      form(action="/auth/sign-up" method="POST")
        .mb-3
          label.form-label(for="fullName") Họ và tên
          input.form-control(
            type="text"
            id="fullName"
            name="fullName"
            placeholder="Nhập tên của bạn"
            required
          )

        .mb-3
          label.form-label(for="email") Email
          input.form-control(
            type="email"
            id="email"
            name="email"
            placeholder="Nhập email của bạn"
            required
          )
        
        .mb-3
          label.form-label(for="phone") Số điện thoại
          input.form-control(
            type="tel"
            id="phone"
            name="phone"
            placeholder="Nhập số điện thoại của bạn"
            required
          )

        .mb-3
          label.form-label(for="password") Mật khẩu
          input.form-control(
            type="password"
            id="password"
            name="password"
            placeholder="Nhập mật khẩu"
            required
          )

        .form-check.mb-3
          input.form-check-input(
            type="checkbox"
            id="view-password"
          )
          label.form-check-label(for="view-password")
            | Hiển thị mật khẩu

        button.btn.btn-primary.w-100(type="submit")
          | Đăng ký

block script
  script(src="/client/js/alert.js")