extends ../../layouts/default.pug
include ../../mixins/friend-tool-bar.pug
include ../../mixins/box-head.pug

block main
  .invite-friend(data-invitation-friend=myUser.id)
    .container
      +friend-tool-bar 
      +box-head("Lời mời kết bạn")
      .row(invitation)
        each inviteUser in invitationFriends
          .col-6(user-invite-id=inviteUser.id)
            div(class="box-users")
              div(class="inner-avatar")
                img(
                  src=(inviteUser.avatar ? inviteUser.avatar : "/client/images/avatar.jpg")
                  alt=inviteUser.fullName
                )
              div(class="inner-info")
                div(class="inner-name") #{inviteUser.fullName}
                div(class="inner-buttons")
                  button(
                    class="btn btn-sm btn-primary mr-1"
                    btn-accept-friend
                  ) Chấp nhận
                  button(
                    class="btn btn-sm btn-secondary mr-1"
                    btn-refuse-friend
                  ) Từ chối
                  button(
                    disabled
                    class="btn btn-sm btn-primary mr-1"
                    btn-accepted-friend
                  ) Đã chấp nhận
block script
  script(src="/client/js/friend.js")