extends ../../layouts/auth.pug
include ../../mixins/alert.pug

block right 
  
  +alert-success(5000)
  +alert-error(5000)

  div(class="d-flex")
    h1(class="text-center") Đổi mật khẩu
    form(
      action=`/forgot/reset?_method=PATCH`
      method="POST"
    )
      div(class="form-group")
        label(for="password") Mật khẩu mới
        input(
          type="password"
          class="form-control"
          id="password"
          name="password"
          required
        )
      div(class="form-group")
        label(for="confirmPassword") Xác nhận lại mật khẩu
        input(
          type="password"
          class="form-control"
          id="confirmPassword"
          name="confirmPassword"
          required
        )
      div(class="form-group")
        button(
          type="submit"
          class="btn btn-primary btn-block"
        ) Đổi mật khẩu
