extends ../../layouts/auth.pug
include ../../mixins/alert.pug

block right 

  +alert-success(5000)
  +alert-error(5000)

  div(class="d-flex")
    h1(class="text-center") Nhập otp
    form(
      action=`/forgot/otp`
      method="POST"
    )
      if(email)
        div(class="form-group")
          label(for="email") Email 
          input(
            type="email"
            class="form-control"
            id="email"
            name="email"
            value=email
            readonly
          )
        div(class="form-group")
          label(for="otp") OTP
          input(
            type="text"
            class="form-control"
            id="otp"
            name="otp"
            required
          )
        div(class="form-group")
          button(
            type="submit"
            class="btn btn-primary btn-block"
          ) Xác nhận