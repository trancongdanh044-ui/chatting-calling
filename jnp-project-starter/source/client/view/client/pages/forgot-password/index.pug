extends ../../layouts/auth.pug
include ../../mixins/alert.pug

block right

  +alert-success(5000)
  +alert-error(5000)
  
  div(class="d-flex")
    h1(class="text-center") Nhận lại mật khẩu
    form(
      action=`/forgot`
      method="POST"
    )
      div(class="form-group")
        label(for="email") Email nhận lại mật khẩu
        input(
          type="email"
          class="form-control"
          id="email"
          name="email"
          required
        )
      div(class="form-group")
        button(
          type="submit"
          class="btn btn-primary btn-block"
        ) Lấy lại mật khẩu